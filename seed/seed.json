	"collections": [
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"description": "The page with slug \"home\" is the home page.",
			"supports": [
				"drafts",
				"revisions",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true
				},
				{
					"slug": "layout",
					"label": "Blocks",
					"type": "blocks",
					"validation": {
						"allowedTypes": [
							"profile",
							"socials",
							"heading",
							"link",
							"text",
							"form"
						],
						"maxItems": 100
					}
				}
			]
		},
		{
			"slug": "r",
			"label": "short links",
			"labelSingular": "short link",
			"description": "Short URLs at /r/{slug}: the entry slug is the code, `url` is where it redirects. Only published links redirect.",
			"supports": [
				"drafts",
				"revisions"
			],
			"urlPattern": "/r/{slug}",
			"fields": [
				{
					"slug": "url",
					"label": "Destination URL",
					"type": "url",
					"required": true,
					"unique": true
				}
			]
		}
