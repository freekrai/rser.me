# Copy to .env for local development. Never commit .env.

# Encrypts plugin secrets in the database. Generate with: bunx emdash secrets generate
EMDASH_ENCRYPTION_KEY=

# Local dev origin (production uses EMDASH_SITE_URL in wrangler.jsonc vars)
EMDASH_SITE_URL=http://localhost:4321

# GetButters tracking (optional; leave blank to disable). Nothing is sent from localhost.
PUBLIC_BUTTERS_KEY=
BUTTERS_API_KEY=
BUTTERS_PROJECT_ID=
