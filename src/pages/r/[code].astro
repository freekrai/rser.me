---
/**
 * Short links: /r/{code} redirects to the `url` of the published entry in the
 * `r` collection whose slug is the code (same as rogerstringer.com's /r/ route).
 * Drafts and unpublished entries 404.
 */
import { decodeSlug, getEmDashEntry, sanitizeHref } from "emdash";
import { trackRedirect } from "../../utils/butters";

const code = decodeSlug(Astro.params.code);
if (!code) return Astro.rewrite("/404");

// The admin accepts slugs typed with a leading slash ("/blog"), so try both forms.
let { entry: link, cacheHint } = await getEmDashEntry("r", code);
if (!link) ({ entry: link, cacheHint } = await getEmDashEntry("r", `/${code}`));
const url = link?.data.url ? sanitizeHref(link.data.url) : null;
// sanitizeHref returns "#" for anything unsafe (javascript: and friends).
if (!url || url === "#") return Astro.rewrite("/404");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
trackRedirect(Astro.request, `/r/${code}`, url, "r");
return Astro.redirect(url, 302);
---
