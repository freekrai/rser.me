---
// A link-style pill that opens its slot content in a daisyUI <dialog> modal.
// - Renders nothing if the slot is empty (e.g. a form that doesn't exist yet).
// - With `href`, the pill is a real link: no-JS visitors just navigate there.
// - Visiting /#<id> opens the dialog directly.
import { Image } from "emdash/ui";

interface Props {
	id: string;
	label: string;
	intro?: string;
	href?: string;
	thumbnail?: any;
	icon?: "mail";
}
const { id, label, intro, href, thumbnail, icon } = Astro.props;
const inner = (await Astro.slots.render("default")).trim();
const Trigger = href ? "a" : "button";
---

{
	inner && (
		<>
			<Trigger
				href={href}
				type={href ? undefined : "button"}
				class="relative mb-4 flex min-h-14 w-full cursor-pointer items-center justify-center rounded-full border border-primary/80 bg-base-100 px-14 py-4 text-center font-medium shadow-[0_0_5px_color-mix(in_oklab,var(--color-primary)_25%,transparent)] transition hover:border-primary hover:bg-base-200 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
				aria-haspopup="dialog"
				aria-controls={id}
				data-open-dialog={id}
			>
				{thumbnail ? (
					<span class="absolute left-2 top-1/2 size-10 -translate-y-1/2 overflow-hidden rounded-full">
						<Image image={thumbnail} width={80} height={80} class="size-10 object-cover" />
					</span>
				) : icon === "mail" ? (
					<svg class="absolute left-5 size-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect width="20" height="16" x="2" y="4" rx="2" />
						<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
					</svg>
				) : null}
				{label}
			</Trigger>

			<dialog id={id} class="modal modal-bottom sm:modal-middle" aria-labelledby={`${id}-title`}>
				<div class="modal-box max-h-[85dvh] rounded-t-3xl sm:rounded-3xl">
					<form method="dialog">
						<button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3" aria-label="Close">✕</button>
					</form>
					<h2 id={`${id}-title`} class="pr-8 text-center text-lg font-semibold text-primary sm:px-8">{label}</h2>
					{intro && <p class="mt-1 text-center text-sm text-base-content/70">{intro}</p>}
					<div class="mt-4">
						<Fragment set:html={inner} />
					</div>
				</div>
				<form method="dialog" class="modal-backdrop">
					<button>close</button>
				</form>
			</dialog>
		</>
	)
}

<script>
	// Open dialogs from their trigger pills, and from a matching URL hash (/#about).
	function openFromHash() {
		const id = decodeURIComponent(location.hash.slice(1));
		const el = id ? document.getElementById(id) : null;
		if (el instanceof HTMLDialogElement && !el.open) el.showModal();
	}
	document.addEventListener("click", (e) => {
		const trigger = (e.target as Element | null)?.closest<HTMLElement>("[data-open-dialog]");
		if (!trigger) return;
		const dialog = document.getElementById(trigger.dataset.openDialog!);
		if (!(dialog instanceof HTMLDialogElement)) return; // fall back to the link
		e.preventDefault();
		dialog.showModal();
	});
	window.addEventListener("hashchange", openFromHash);
	openFromHash();
</script>
