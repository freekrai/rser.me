---
import { siBluesky, siGithub, siInstagram, siMastodon, siThreads, siTiktok, siX, siYoutube } from "simple-icons";

interface Props {
	platform?: string | null;
	class?: string;
}

const icons: Record<string, string> = {
	x: siX.path,
	tiktok: siTiktok.path,
	threads: siThreads.path,
	instagram: siInstagram.path,
	github: siGithub.path,
	bluesky: siBluesky.path,
	youtube: siYoutube.path,
	mastodon: siMastodon.path,
};

const { platform, class: className = "size-5" } = Astro.props;
const path = platform ? icons[platform] : undefined;
---

{
	path ? (
		<svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d={path} />
		</svg>
	) : (
		<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="10" />
			<path d="M2 12h20" />
			<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
		</svg>
	)
}
